# Chest Xpert Backend — Environment variables
# Copy to .env and fill in real values. Never commit .env.

# Server
CHESTXPERT_HOST=0.0.0.0
CHESTXPERT_PORT=8000
CHESTXPERT_WORKERS=1
CHESTXPERT_CORS_ORIGINS=*

# Security (optional — enable for demos with sensitive uploads)
CHESTXPERT_REQUIRE_AUTH=false
CHESTXPERT_API_KEY=change-me-in-production

# Model / inference
CHESTXPERT_DEVICE=auto          # auto | cuda | cpu
CHESTXPERT_MAX_CONCURRENT_JOBS=1   # serialize GPU jobs
CHESTXPERT_JOB_TIMEOUT_S=300
CHESTXPERT_GRAD_CAM_ENABLED=true

# Storage / artifacts
CHESTXPERT_TEMP_DIR=./temp
CHESTXPERT_REPORTS_DIR=./reports
CHESTXPERT_ARTIFACT_TTL_S=86400     # 24 hours
CHESTXPERT_MAX_UPLOAD_MB=50
CHESTXPERT_MAX_DIMENSION=4096

# Modality validation
CHESTXPERT_MODALITY_ENABLED=true
CHESTXPERT_HF_TOKEN=your_hf_read_token_here   # only needed for Qwen VLM

# Optional LLM (Stages B/C) — app works without these (template fallback)
CHESTXPERT_LLM_API_URL=
CHESTXPERT_LLM_API_TOKEN=
CHESTXPERT_LLM_MODEL_ID=
